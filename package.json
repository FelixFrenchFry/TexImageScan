{
  "name": "teximagescan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/licenses.mjs && wxt build",
    "zip": "node scripts/licenses.mjs && wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "model:download": "node scripts/model-assets.ts download",
    "model:verify": "node scripts/model-assets.ts verify",
    "samples:generate": "node scripts/generate-samples.mjs",
    "samples:capture-web": "node scripts/capture-web-samples.mjs",
    "logo:render": "node scripts/render-logo.mjs",
    "benchmark": "node scripts/math-benchmark/run.ts",
    "corpus:capture": "node scripts/corpus-capture.mjs",
    "corpus:provenance": "node scripts/corpus-provenance.mjs",
    "corpus:audit": "node scripts/corpus-audit.mjs",
    "corpus:verify": "node scripts/corpus-verify.mjs --frozen",
    "corpus:score": "node scripts/corpus-score.mjs",
    "corpus:v2:verify": "node scripts/corpus-verify.mjs --corpus tests/corpus-v2 --frozen",
    "corpus:v2:score": "node scripts/corpus-score.mjs --corpus tests/corpus-v2",
    "test:model-lifecycle": "node scripts/test-model-lifecycle.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test:capture": "node scripts/test-capture.mjs",
    "test:lasso": "node scripts/test-capture.mjs --lasso",
    "test:math": "node scripts/test-math.mjs",
    "test:math-ui": "node scripts/test-math-ui.mjs",
    "test:shortcut": "node scripts/test-shortcut.mjs",
    "check:ui-style": "playwright test --grep @style",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:browser && pnpm test:package",
    "benchmark:verify": "node scripts/math-benchmark/manifest.ts verify",
    "benchmark:export": "node scripts/math-benchmark/manifest.ts export",
    "benchmark:report": "node scripts/math-benchmark/summarize.ts",
    "benchmark:freeze": "node scripts/math-benchmark/freeze.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@radix-ui/themes": "3.3.0",
    "idb": "8.0.4",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.69",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.5",
    "linkedom": "0.18.14",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
